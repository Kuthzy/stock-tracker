# Copy this file to .env and fill in what you have. Everything is optional;
# the bot runs on free data with alerts printed to the console.
# Put values right after the = sign, with no spaces or comments on the same line.

# --- Alerts ---
# Telegram: token from @BotFather, chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Free push alerts: install the ntfy app and subscribe to a hard-to-guess topic name
NTFY_TOPIC=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Data ---
# Free key from finnhub.io (extra company news)
FINNHUB_API_KEY=
# The SEC asks for a contact email in requests
SEC_USER_AGENT=StockTrackerBot your-email@example.com

# --- AI headline classification (optional) ---
ANTHROPIC_API_KEY=
